<ui:ContentDialog
    x:Class="ComfyUIRunWorkflow.Views.Controls.ImagePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ComfyUIRunWorkflow.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ComfyUIRunWorkflow.Helpers"
    Title="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[ImagePreview_Title]}"
    d:DesignWidth="700"
    d:DesignHeight="840"
    Width="700"
    Height="840"
    MinWidth="320"
    MinHeight="240"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:ImagePreviewWindow}" />
    </ui:ContentDialog.Resources>

    <Border
        Margin="0,8,0,0"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Image
            x:Name="PreviewImage"
            Margin="8"
            Stretch="Uniform" />
    </Border>
</ui:ContentDialog>
