<Page
    x:Class="ComfyUIRunWorkflow.Views.Pages.GeneratePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ComfyUIRunWorkflow.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="clr-namespace:ComfyUIRunWorkflow.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GeneratePage"
    d:DataContext="{d:DesignInstance local:GeneratePage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- タイトル -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Generate_Title]}" />
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,12"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Generate_Description]}"
                TextWrapping="Wrap" />
        </Grid>

        <!-- ベースプロンプトディレクトリ -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Symbol="Folder24" />
                <TextBlock
                    Grid.Column="1"
                    Width="300"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Generate_BasePromptDirectoryLabel]}" />
                <ui:TextBox
                    Grid.Column="2"
                    Height="36"
                    Margin="0,0,4,0"
                    IsReadOnly="True"
                    PlaceholderText="C:\...\base_prompts"
                    Text="{Binding ViewModel.Config.Data.GenerateBasePromptDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Grid.Column="3"
                    Width="36"
                    Height="36"
                    Margin="4,0,0,0"
                    Command="{Binding ViewModel.BrowseBasePromptDirectoryCommand}"
                    Icon="{ui:SymbolIcon FolderOpen16}"
                    ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_BrowseButtonTooltip]}"
                    Appearance="Secondary" />
            </Grid>
        </Border>

        <!-- 置換リストファイル -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Symbol="ArrowSwap24" />
                <TextBlock
                    Grid.Column="1"
                    Width="300"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Generate_ReplacementListLabel]}" />
                <ui:TextBox
                    Grid.Column="2"
                    Height="36"
                    Margin="0,0,4,0"
                    IsReadOnly="True"
                    PlaceholderText="C:\...\replacements.json"
                    Text="{Binding ViewModel.Config.Data.GenerateReplacementListPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Grid.Column="3"
                    Width="36"
                    Height="36"
                    Margin="4,0,0,0"
                    Command="{Binding ViewModel.BrowseReplacementListPathCommand}"
                    Icon="{ui:SymbolIcon FolderOpen16}"
                    ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_BrowseButtonTooltip]}"
                    Appearance="Secondary" />
            </Grid>
        </Border>

        <!-- ジョブテンプレートファイル -->
        <Border
            Grid.Row="3"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Symbol="DocumentSettings20" />
                <TextBlock
                    Grid.Column="1"
                    Width="300"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Generate_JobTemplateLabel]}" />
                <ui:TextBox
                    Grid.Column="2"
                    Height="36"
                    Margin="0,0,4,0"
                    IsReadOnly="True"
                    PlaceholderText="C:\...\job_template.json"
                    Text="{Binding ViewModel.Config.Data.GenerateJobTemplatePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Grid.Column="3"
                    Width="36"
                    Height="36"
                    Margin="4,0,0,0"
                    Command="{Binding ViewModel.BrowseJobTemplatePathCommand}"
                    Icon="{ui:SymbolIcon FolderOpen16}"
                    ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_BrowseButtonTooltip]}"
                    Appearance="Secondary" />
            </Grid>
        </Border>

        <!-- 出力先ファイル -->
        <Border
            Grid.Row="4"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Symbol="SaveArrowRight24" />
                <TextBlock
                    Grid.Column="1"
                    Width="300"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Generate_OutputPathLabel]}" />
                <ui:TextBox
                    Grid.Column="2"
                    Height="36"
                    Margin="0,0,4,0"
                    IsReadOnly="True"
                    PlaceholderText="C:\...\queue_jobs_generated.json"
                    Text="{Binding ViewModel.Config.Data.GenerateOutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Grid.Column="3"
                    Width="36"
                    Height="36"
                    Margin="4,0,0,0"
                    Command="{Binding ViewModel.BrowseOutputPathCommand}"
                    Icon="{ui:SymbolIcon FolderOpen16}"
                    ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_BrowseButtonTooltip]}"
                    Appearance="Secondary" />
            </Grid>
        </Border>

        <!-- 生成ボタン -->
        <ui:Button
            Grid.Row="5"
            Margin="0,0,0,8"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Command="{Binding ViewModel.GenerateCommand}"
            Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Generate_GenerateButtonContent]}"
            Appearance="Primary"
            Icon="{ui:SymbolIcon Wand24}" />

        <!-- ログ -->
        <Border
            Grid.Row="6"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    FontSize="13"
                    FontWeight="Medium"
                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Generate_Log_Title]}" />
                <ui:TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{Binding ViewModel.Log, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</Page>
