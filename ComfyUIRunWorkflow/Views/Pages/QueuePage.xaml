<Page
    x:Class="ComfyUIRunWorkflow.Views.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ComfyUIRunWorkflow.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ComfyUIRunWorkflow.Models"
    xmlns:vm="clr-namespace:ComfyUIRunWorkflow.ViewModels.Pages"
    xmlns:helpers="clr-namespace:ComfyUIRunWorkflow.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="QueuePage"
    d:DataContext="{d:DesignInstance local:QueuePage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Queue_Title]}" />

        <!-- ツールバー -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.AddJobCommand}"
                        Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Queue_AddJobButtonContent]}"
                        IsEnabled="{Binding ViewModel.CanEditJobs}"
                        Appearance="Secondary" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.RunAllCommand}"
                        Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Queue_RunAllButtonContent]}"
                        Appearance="Primary"
                        Icon="{ui:SymbolIcon Play24}"
                        Visibility="{Binding ViewModel.IsRunning, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding ViewModel.CancelQueueCommand}"
                        Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Queue_CancelButtonContent]}"
                        Appearance="Danger"
                        Icon="{ui:SymbolIcon Stop24}"
                        Visibility="{Binding ViewModel.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <ProgressBar
                    Margin="0,8,0,0"
                    Height="4"
                    IsIndeterminate="True"
                    Visibility="{Binding ViewModel.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.OverallProgressText}"
                    Visibility="{Binding ViewModel.OverallProgressText, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!-- 本体: 左=ジョブ一覧, 右=個別編集パネル -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ジョブ一覧 -->
            <Border
                Grid.Column="0"
                Grid.Row="0"
                Margin="0,0,8,0"
                Padding="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Queue_JobListEmptyPlaceholder]}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding ViewModel.HasJobs, Converter={StaticResource BoolToVisibilityInverseConverter}}" />

                        <ui:ListView
                            BorderThickness="0"
                            Background="Transparent"
                            ItemsSource="{Binding ViewModel.Jobs}"
                            SelectedItem="{Binding ViewModel.SelectedJob, Mode=TwoWay}"
                            Visibility="{Binding ViewModel.HasJobs, Converter={StaticResource BoolToVisibilityConverter}}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ui:ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QueueJobViewModel}">
                                    <Border
                                        Padding="8"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="Medium"
                                                Text="{Binding WorkflowName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                Foreground="{Binding Status, Converter={StaticResource QueueJobStatusToBrushConverter}}"
                                                Text="{Binding StatusLabel}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding StatusMessage}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                                            <StackPanel
                                                Margin="0,6,0,0"
                                                Orientation="Horizontal">
                                                <ui:Button
                                                    Margin="0,0,4,0"
                                                    Padding="6,2"
                                                    Command="{Binding DataContext.ViewModel.OpenJobDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Queue_DetailButtonContent]}"
                                                    IsEnabled="{Binding HasLastResult}"
                                                    Appearance="Secondary"
                                                    FontSize="11" />
                                                <ui:Button
                                                    Padding="6,2"
                                                    Command="{Binding DataContext.ViewModel.RemoveJobCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.ViewModel.CanEditJobs, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                    Appearance="Danger"
                                                    Icon="{ui:SymbolIcon Dismiss12}"
                                                    FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 個別編集パネル(ジョブ未選択) -->
            <Border
                Grid.Column="1"
                Grid.Row="0"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding ViewModel.SelectedJob, Converter={StaticResource NullToVisibilityInverseConverter}}" >
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Queue_NoJobSelectedPlaceholder]}"
                        TextAlignment="Center" />
                </Grid>
            </Border>

            <!-- 個別編集パネル(ジョブ選択) -->
            <Grid
                Grid.Column="1"
                DataContext="{Binding ViewModel.SelectedJob}"
                IsEnabled="{Binding DataContext.ViewModel.CanEditJobs, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                Visibility="{Binding DataContext.ViewModel.SelectedJob, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Padding="12"
                    Grid.Row="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <!-- ワークフロー選択 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Symbol="Flowchart24" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Dashboard_WorkflowLabel]}" />
                        <ComboBox
                            Grid.Column="2"
                            Width="200"
                            ItemsSource="{Binding DataContext.ViewModel.WorkflowNames, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                            SelectedItem="{Binding WorkflowName, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- プロンプト -->
                <Border
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,4"
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_PositivePromptLabel]}" />
                        <ui:TextBox
                            Grid.Row="1"
                            AcceptsReturn="True"
                            PlaceholderText="masterpiece, best quality, ..."
                            Text="{Binding PositivePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,8,0,4"
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_NegativePromptLabel]}" />
                        <ui:TextBox
                            Grid.Row="3"
                            AcceptsReturn="True"
                            Height="60"
                            PlaceholderText="worst quality, bad quality, ..."
                            Text="{Binding NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <!-- 画像サイズ -->
                <Border
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_ImageSizeLabel]}" />
                        <ComboBox
                            Grid.Row="1"
                            Width="220"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding SizeLabelList.ItemList}"
                            SelectedValue="{Binding SelectedSizeOption, Mode=TwoWay}"
                            SelectedValuePath="Key" />
                        <StackPanel
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding IsCustomSize, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Text="Width" />
                            <ui:NumberBox
                                Width="160"
                                Margin="0,0,16,0"
                                Maximum="2048"
                                Minimum="512"
                                SpinButtonPlacementMode="Compact"
                                Value="{Binding CustomWidth, Mode=TwoWay}" />
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Text="Height" />
                            <ui:NumberBox
                                Width="160"
                                Maximum="2048"
                                Minimum="512"
                                SpinButtonPlacementMode="Compact"
                                Value="{Binding CustomHeight, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LoRA -->
                <Border
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Dashboard_LoraSectionLabel]}" />
                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{Binding LoraSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LoraSlot}">
                                    <StackPanel Margin="0,0,8,4" Orientation="Horizontal">
                                        <ComboBox
                                            Width="160"
                                            ItemsSource="{Binding DataContext.AvailableLoras, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            SelectedItem="{Binding SelectedLora, Mode=TwoWay}" />
                                        <ui:Button
                                            Margin="4,0,0,0"
                                            Padding="4,0"
                                            Command="{Binding DataContext.RemoveLoraCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Appearance="Danger"
                                            Icon="{ui:SymbolIcon Dismiss12}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button
                            Grid.Row="2"
                            Margin="0,4,0,0"
                            Command="{Binding AddLoraCommand}"
                            Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Dashboard_AddLoraButtonContent]}"
                            Appearance="Secondary" />
                    </Grid>
                </Border>

                <!-- バッチ数・ファイル名プレフィックス -->
                <Border
                    Grid.Row="4"
                    Margin="0,8,0,0"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Dashboard_BatchCountLabel]}" />
                        <ui:NumberBox
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Width="120"
                            Maximum="10"
                            Minimum="1"
                            HorizontalAlignment="Left"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding BatchCount, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_FilenamePrefixLabel]}" />
                        <ui:TextBox
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_FilenamePrefixPlaceholder]}"
                            Text="{Binding FilenamePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
